{"maps":{"skel":{"src":"data/skeleton.svg","w":435.687,"h":841.89,"credit":"Mariana Ruiz Villarreal (LadyofHats), Mikael Häggström / Public domain"},"muscle":{"src":"data/muscles.svg","w":406.99026,"h":354.43411,"credit":"OpenStax, Tomáš Kebert & umimeto.org / CC BY-SA 4.0"}},"items":[{"id":"bone-0","cat":"bone","lvs":[1],"segs":[{"t":"頭"},{"t":"の"},{"t":"骨","r":"ほね"}],"x":202,"y":55,"map":"skel","region":"頭","hint":"{脳|のう}を 守っている、かたい{骨|ほね}。いくつかの{骨|ほね}が つながってできている。"},{"id":"bone-1","cat":"bone","lvs":[1],"segs":[{"t":"むね"},{"t":"の"},{"t":"骨","r":"ほね"}],"x":160,"y":225,"map":"skel","region":"むね","hint":"かごのような形で、{心臓|しんぞう}や{肺|はい}を守っている。息をすると少し動く。"},{"id":"bone-2","cat":"bone","lvs":[1],"segs":[{"t":"せぼね"}],"x":202,"y":320,"map":"skel","region":"せなか・こし","hint":"小さな{骨|ほね}が たてに いくつも つながっている。体を{支|ささ}え、曲げたり ひねったりできる。"},{"id":"bone-3","cat":"bone","lvs":[1],"segs":[{"t":"こし"},{"t":"の"},{"t":"骨","r":"ほね"}],"x":248,"y":348,"map":"skel","region":"こし","hint":"おなかの下で、{内臓|ないぞう}を下から{支|ささ}える。あしの{骨|ほね}と つながっている。"},{"id":"bone-4","cat":"bone","lvs":[1],"segs":[{"t":"うで"},{"t":"の"},{"t":"骨","r":"ほね"}],"x":301,"y":239,"map":"skel","region":"うで","hint":"かたから ひじまでの、うでの つけねの太い{骨|ほね}。"},{"id":"bone-5","cat":"bone","lvs":[1],"segs":[{"t":"あし"},{"t":"の"},{"t":"骨","r":"ほね"}],"x":243,"y":485,"map":"skel","region":"あし","hint":"足のつけねから ひざまでの、体の中でいちばん長い{骨|ほね}。"},{"id":"bone-6","cat":"bone","lvs":[2],"segs":[{"t":"頭蓋骨","r":"ずがいこつ","hard":1}],"x":202,"y":55,"map":"skel","region":"頭","hint":"脳を守る骨。医学では「とうがいこつ」とも読む。15種23個ほどの骨が組み合わさっている。"},{"id":"bone-7","cat":"bone","lvs":[2,3],"segs":[{"t":"下顎骨","r":"かがくこつ","hard":1}],"x":202,"y":118,"map":"skel","region":"頭","hint":"下あごの骨。頭の骨の中で、関節で動くただ一つの大きな骨。"},{"id":"bone-8","cat":"bone","lvs":[2,3],"segs":[{"t":"鎖骨","r":"さこつ","hard":1}],"x":248,"y":152,"map":"skel","region":"むね","hint":"むねの上で、胸骨と肩甲骨をつなぐ、ゆるいS字の骨。"},{"id":"bone-9","cat":"bone","lvs":[2,3],"segs":[{"t":"肩甲骨","r":"けんこうこつ","hard":1}],"x":128,"y":190,"map":"skel","region":"せなか・かた","hint":"せなか側にある逆三角形の平たい骨。上腕骨と肩関節をつくる。"},{"id":"bone-10","cat":"bone","lvs":[2,3],"segs":[{"t":"胸骨","r":"きょうこつ","hard":1}],"x":203,"y":212,"map":"skel","region":"むね","hint":"むねのまん中にある、たてに長い平たい骨。ろっ骨の前のはしがつく。"},{"id":"bone-11","cat":"bone","lvs":[2,3],"segs":[{"t":"ろっ骨","r":"ろっこつ","hard":1}],"x":160,"y":225,"map":"skel","region":"むね","hint":"左右12対。むねのかごをつくり、心臓と肺を守る。"},{"id":"bone-12","cat":"bone","lvs":[2],"segs":[{"t":"背骨","r":"せぼね"}],"x":202,"y":320,"map":"skel","region":"せなか・こし","hint":"椎骨(ついこつ)が たてに積み重なった柱。首からこしまで続く。脊柱(せきちゅう)ともいう。"},{"id":"bone-13","cat":"bone","lvs":[3],"segs":[{"t":"頸椎","r":"けいつい","hard":1}],"x":203,"y":140,"map":"skel","region":"首","hint":"首の部分の背骨。7個ある。"},{"id":"bone-14","cat":"bone","lvs":[3],"segs":[{"t":"胸椎","r":"きょうつい","hard":1}],"x":202,"y":268,"map":"skel","region":"せなか","hint":"むねの部分の背骨。12個あり、ろっ骨とつながる。"},{"id":"bone-15","cat":"bone","lvs":[3],"segs":[{"t":"腰椎","r":"ようつい","hard":1}],"x":202,"y":320,"map":"skel","region":"こし","hint":"こしの部分の背骨。5個あり、いちばん太い。"},{"id":"bone-16","cat":"bone","lvs":[2,3],"segs":[{"t":"仙骨","r":"せんこつ","hard":1}],"x":202,"y":360,"map":"skel","region":"こし","hint":"背骨の下の、5個の椎骨が1つにくっついた三角形の骨。骨盤の一部。"},{"id":"bone-17","cat":"bone","lvs":[2,3],"segs":[{"t":"尾骨","r":"びこつ","hard":1}],"x":201,"y":388,"map":"skel","region":"こし","hint":"背骨のいちばん下のはし。しっぽの名残の骨。"},{"id":"bone-18","cat":"bone","lvs":[2],"segs":[{"t":"骨盤","r":"こつばん","hard":1}],"x":248,"y":348,"map":"skel","region":"こし","hint":"左右の寛骨(かんこつ)と、仙骨・尾骨でできた、たらいのような形の骨。"},{"id":"bone-19","cat":"bone","lvs":[2,3],"segs":[{"t":"上腕骨","r":"じょうわんこつ","hard":1}],"x":301,"y":239,"map":"skel","region":"うで","hint":"かたからひじまでの骨。"},{"id":"bone-20","cat":"bone","lvs":[2,3],"segs":[{"t":"橈骨","r":"とうこつ","hard":1}],"x":345,"y":370,"map":"skel","region":"うで","hint":"ひじから手首までの2本のうち、親指側の骨。"},{"id":"bone-21","cat":"bone","lvs":[2,3],"segs":[{"t":"尺骨","r":"しゃっこつ","hard":1}],"x":320,"y":365,"map":"skel","region":"うで","hint":"ひじから手首までの2本のうち、小指側の骨。ひじの出っぱりはこの骨。"},{"id":"bone-22","cat":"bone","lvs":[3],"segs":[{"t":"手根骨","r":"しゅこんこつ","hard":1}],"x":352,"y":416,"map":"skel","region":"手","hint":"手首にある8個の小さな骨。"},{"id":"bone-23","cat":"bone","lvs":[3],"segs":[{"t":"中手骨","r":"ちゅうしゅこつ","hard":1}],"x":367,"y":433,"map":"skel","region":"手","hint":"手のひらの中にある5本の骨。"},{"id":"bone-24","cat":"bone","lvs":[2,3],"segs":[{"t":"指骨","r":"しこつ","hard":1}],"x":379.1,"y":467,"map":"skel","region":"手","hint":"手の指の骨。親指は2個、ほかの指は3個ずつ。"},{"id":"bone-25","cat":"bone","lvs":[2,3],"segs":[{"t":"大腿骨","r":"だいたいこつ","hard":1}],"x":243,"y":485,"map":"skel","region":"あし","hint":"ももの骨。体の中でいちばん長くて太い骨。"},{"id":"bone-26","cat":"bone","lvs":[2,3],"segs":[{"t":"膝蓋骨","r":"しつがいこつ","hard":1}],"x":229,"y":593,"map":"skel","region":"ひざ","hint":"ひざのお皿。太ももの前の筋肉の腱の中にある。"},{"id":"bone-27","cat":"bone","lvs":[2,3],"segs":[{"t":"脛骨","r":"けいこつ","hard":1}],"x":218,"y":680,"map":"skel","region":"あし","hint":"すねの2本の骨のうち、内側の太い骨。体重を支える。"},{"id":"bone-28","cat":"bone","lvs":[2,3],"segs":[{"t":"腓骨","r":"ひこつ","hard":1}],"x":238.1,"y":691,"map":"skel","region":"あし","hint":"すねの2本の骨のうち、外側の細い骨。"},{"id":"bone-29","cat":"bone","lvs":[2],"segs":[{"t":"足根骨","r":"そっこんこつ","hard":1}],"x":176,"y":774,"map":"skel","region":"足","hint":"かかとや足首の7個の骨。かかとの骨(踵骨)がいちばん大きい。"},{"id":"bone-30","cat":"bone","lvs":[3],"segs":[{"t":"中足骨","r":"ちゅうそくこつ","hard":1}],"x":165,"y":790,"map":"skel","region":"足","hint":"足の甲にある5本の骨。"},{"id":"bone-31","cat":"bone","lvs":[3],"segs":[{"t":"趾骨","r":"しこつ","hard":1}],"x":148.6,"y":799.1,"map":"skel","region":"足","hint":"足の指の骨。親指は2個、ほかの指はふつう3個ずつ。"},{"id":"bone-32","cat":"bone","lvs":[3],"segs":[{"t":"前頭骨","r":"ぜんとうこつ","hard":1}],"x":202,"y":38,"map":"skel","region":"頭","hint":"おでこの骨。目の上のふちまでをおおっている。"},{"id":"bone-33","cat":"bone","lvs":[3],"segs":[{"t":"側頭骨","r":"そくとうこつ","hard":1}],"x":170,"y":60,"map":"skel","region":"頭","hint":"頭の横、耳のまわりの骨。中に、音を伝える小さな骨(耳小骨)がおさまっている。"},{"id":"bone-34","cat":"bone","lvs":[3],"segs":[{"t":"頬骨","r":"きょうこつ","hard":1}],"x":181,"y":83,"map":"skel","region":"頭","hint":"ほお骨。目の下の、外側の出っぱり。"},{"id":"bone-35","cat":"bone","lvs":[3],"segs":[{"t":"上顎骨","r":"じょうがくこつ","hard":1}],"x":192,"y":96,"map":"skel","region":"頭","hint":"上あごの骨。上の歯が生えている。鼻のあなの横にある。"},{"id":"bone-36","cat":"bone","lvs":[3],"segs":[{"t":"鼻骨","r":"びこつ","hard":1}],"x":202,"y":66,"map":"skel","region":"頭","hint":"鼻のつけねの、鼻すじの上の部分をつくる小さな骨。"},{"id":"bone-37","cat":"bone","lvs":[3],"segs":[{"t":"剣状突起","r":"けんじょうとっき","hard":1}],"x":203,"y":238,"map":"skel","region":"むね","hint":"胸骨のいちばん下の、小さくとがった部分(胸骨の一部)。"},{"id":"bone-38","cat":"bone","lvs":[3],"segs":[{"t":"肋軟骨","r":"ろくなんこつ","hard":1}],"x":184,"y":226,"map":"skel","region":"むね","hint":"ろっ骨の前のはしと、胸骨をつなぐ部分。骨ではなく軟骨。"},{"id":"bone-39","cat":"bone","lvs":[3],"segs":[{"t":"腸骨","r":"ちょうこつ","hard":1}],"x":252,"y":346,"map":"skel","region":"こし","hint":"骨盤の上の、左右に大きく広がる部分。こしに手を当てるとふれる。"},{"id":"bone-40","cat":"bone","lvs":[3],"segs":[{"t":"恥骨","r":"ちこつ","hard":1}],"x":207,"y":403,"map":"skel","region":"こし","hint":"骨盤の前の下の部分。左右の恥骨は、前のまん中でつながっている。"},{"id":"bone-41","cat":"bone","lvs":[3],"segs":[{"t":"坐骨","r":"ざこつ","hard":1}],"x":233,"y":413,"map":"skel","region":"こし","hint":"骨盤のいちばん下の部分。いすにすわると、ここに体重がかかる。"},{"id":"bone-42","cat":"bone","lvs":[3],"segs":[{"t":"距骨","r":"きょこつ","hard":1}],"x":217,"y":772,"map":"skel","region":"足","hint":"足首の関節をつくる足根骨。脛骨と腓骨の下にはまっている。"},{"id":"joint-43","cat":"joint","lvs":[1],"segs":[{"t":"かた"}],"x":283,"y":172,"map":"skel","region":"うで","hint":"うでを ぐるぐる回せる、よく動く関節。"},{"id":"joint-44","cat":"joint","lvs":[1],"segs":[{"t":"ひじ"}],"x":318,"y":307,"map":"skel","region":"うで","hint":"うでの まん中で曲がる関節。"},{"id":"joint-45","cat":"joint","lvs":[1],"segs":[{"t":"手首"}],"x":350,"y":410,"map":"skel","region":"手","hint":"手のひらを 曲げたり 反らしたりできる関節。"},{"id":"joint-46","cat":"joint","lvs":[1],"segs":[{"t":"足"},{"t":"の"},{"t":"つけね"}],"x":246,"y":388,"map":"skel","region":"こし","hint":"あしを 前後や横に 動かせる関節。こしの{骨|ほね}と あしの{骨|ほね}の つなぎ目。"},{"id":"joint-47","cat":"joint","lvs":[1],"segs":[{"t":"ひざ"}],"x":204,"y":586,"map":"skel","region":"あし","hint":"あしの まん中で曲がる関節。"},{"id":"joint-48","cat":"joint","lvs":[1],"segs":[{"t":"足首"}],"x":226,"y":766,"map":"skel","region":"足","hint":"足の先を 上げ下げできる関節。"},{"id":"joint-49","cat":"joint","lvs":[2,3],"segs":[{"t":"肩関節","r":"かたかんせつ","hard":1}],"x":283,"y":172,"map":"skel","region":"うで","hint":"上腕骨と肩甲骨のあいだ。体の中でいちばん大きく動く関節。"},{"id":"joint-50","cat":"joint","lvs":[2,3],"segs":[{"t":"肘関節","r":"ちゅうかんせつ","hard":1}],"x":318,"y":307,"map":"skel","region":"うで","hint":"上腕骨と、橈骨・尺骨のあいだ。「ひじかんせつ」とも読む。"},{"id":"joint-51","cat":"joint","lvs":[2,3],"segs":[{"t":"手関節","r":"しゅかんせつ","hard":1}],"x":350,"y":410,"map":"skel","region":"手","hint":"橈骨と手根骨のあいだ。手首の関節。"},{"id":"joint-52","cat":"joint","lvs":[2,3],"segs":[{"t":"股関節","r":"こかんせつ","hard":1}],"x":246,"y":388,"map":"skel","region":"こし","hint":"骨盤と大腿骨のあいだ。大腿骨の丸い頭が、骨盤のくぼみにはまっている。"},{"id":"joint-53","cat":"joint","lvs":[2,3],"segs":[{"t":"膝関節","r":"しつかんせつ","hard":1}],"x":204,"y":586,"map":"skel","region":"あし","hint":"大腿骨と脛骨のあいだ。「ひざかんせつ」とも読む。"},{"id":"joint-54","cat":"joint","lvs":[2,3],"segs":[{"t":"足関節","r":"そくかんせつ","hard":1}],"x":226,"y":766,"map":"skel","region":"足","hint":"脛骨・腓骨と、足根骨の距骨(きょこつ)のあいだ。足首の関節。"},{"id":"muscle-55","cat":"muscle","lvs":[1],"segs":[{"t":"うで"},{"t":"を"},{"t":"曲"},{"t":"げる"},{"t":"筋肉","r":"きんにく"}],"x":55.6,"y":105.8,"map":"muscle","region":"うで(前から見た図)","hint":"力こぶの{筋肉|きんにく}。うでを曲げると ちぢんで、ふくらむ。"},{"id":"muscle-56","cat":"muscle","lvs":[1],"segs":[{"t":"うで"},{"t":"を"},{"t":"のばす"},{"t":"筋肉","r":"きんにく"}],"x":275,"y":110,"map":"muscle","region":"うで(後ろから見た図)","hint":"うでの うら側の{筋肉|きんにく}。うでを のばすと ちぢむ。"},{"id":"muscle-57","cat":"muscle","lvs":[1],"segs":[{"t":"むね"},{"t":"の"},{"t":"筋肉","r":"きんにく"}],"x":80.7,"y":87.3,"map":"muscle","region":"むね(前から見た図)","hint":"むねの前の、大きく平たい{筋肉|きんにく}。うでを前にだきよせる。"},{"id":"muscle-58","cat":"muscle","lvs":[1],"segs":[{"t":"おなか"},{"t":"の"},{"t":"筋肉","r":"きんにく"}],"x":93.9,"y":127,"map":"muscle","region":"おなか(前から見た図)","hint":"おなかの まん中の{筋肉|きんにく}。体を前に曲げる。"},{"id":"muscle-59","cat":"muscle","lvs":[1],"segs":[{"t":"もも"},{"t":"の"},{"t":"前"},{"t":"の"},{"t":"筋肉","r":"きんにく"}],"x":84.7,"y":203.7,"map":"muscle","region":"あし(前から見た図)","hint":"ふとももの前の{筋肉|きんにく}。ひざを のばす。"},{"id":"muscle-60","cat":"muscle","lvs":[1],"segs":[{"t":"ふくらはぎ"},{"t":"の"},{"t":"筋肉","r":"きんにく"}],"x":300.3,"y":262,"map":"muscle","region":"あし(後ろから見た図)","hint":"ひざの下の うら側の{筋肉|きんにく}。つま先で立つときに 使う。"},{"id":"muscle-61","cat":"muscle","lvs":[1],"segs":[{"t":"アキレスけん"}],"x":304.3,"y":304.3,"map":"muscle","region":"足(後ろから見た図)","hint":"ふくらはぎの{筋肉|きんにく}と、かかとの{骨|ほね}を つないでいる。{筋肉|きんにく}と{骨|ほね}は「けん」で つながっている。"},{"id":"muscle-62","cat":"muscle","lvs":[2,3],"segs":[{"t":"上腕二頭筋","r":"じょうわんにとうきん","hard":1}],"x":55.6,"y":105.8,"map":"muscle","region":"うで(前)","hint":"力こぶの筋肉。ひじを曲げる。"},{"id":"muscle-63","cat":"muscle","lvs":[2,3],"segs":[{"t":"上腕三頭筋","r":"じょうわんさんとうきん","hard":1}],"x":275,"y":110,"map":"muscle","region":"うで(後ろ)","hint":"上腕のうら側。ひじをのばす。"},{"id":"muscle-64","cat":"muscle","lvs":[2,3],"segs":[{"t":"三角筋","r":"さんかくきん"}],"x":58.7,"y":79.4,"map":"muscle","region":"かた(前)","hint":"かたを丸くおおう筋肉。うでを横に上げる。"},{"id":"muscle-65","cat":"muscle","lvs":[2,3],"segs":[{"t":"大胸筋","r":"だいきょうきん","hard":1}],"x":80.7,"y":87.3,"map":"muscle","region":"むね(前)","hint":"むねの大きな筋肉。うでを前に閉じる。"},{"id":"muscle-66","cat":"muscle","lvs":[2,3],"segs":[{"t":"腹直筋","r":"ふくちょくきん","hard":1}],"x":93.9,"y":127,"map":"muscle","region":"おなか(前)","hint":"おなかの中央をたてに走る。体を前に曲げる。「シックスパック」の筋肉。"},{"id":"muscle-67","cat":"muscle","lvs":[2,3],"segs":[{"t":"大腿四頭筋","r":"だいたいしとうきん","hard":1}],"x":84.7,"y":203.7,"map":"muscle","region":"あし(前)","hint":"ももの前の4つの筋肉。ひざをのばす。"},{"id":"muscle-68","cat":"muscle","lvs":[2,3],"segs":[{"t":"大殿筋","r":"だいでんきん","hard":1}],"x":299,"y":170.7,"map":"muscle","region":"おしり(後ろ)","hint":"おしりの大きな筋肉。股関節をのばす(あしを後ろにふる)。"},{"id":"muscle-69","cat":"muscle","lvs":[2,3],"segs":[{"t":"下腿三頭筋","r":"かたいさんとうきん","hard":1}],"x":300.3,"y":262,"map":"muscle","region":"あし(後ろ)","hint":"ふくらはぎの筋肉(腓腹筋とヒラメ筋)。つま先立ちで使う。"},{"id":"muscle-70","cat":"muscle","lvs":[2,3],"segs":[{"t":"アキレス腱","r":"アキレスけん","hard":1}],"x":304.3,"y":304.3,"map":"muscle","region":"足(後ろ)","hint":"下腿三頭筋がかかとの骨(踵骨)につく、体でいちばん太い腱。"},{"id":"muscle-71","cat":"muscle","lvs":[3],"segs":[{"t":"胸鎖乳突筋","r":"きょうさにゅうとつきん","hard":1}],"x":93,"y":55.5,"map":"muscle","region":"首(前)","hint":"耳の後ろから、胸骨と鎖骨へななめに走る首の筋肉。首を回す。"},{"id":"muscle-72","cat":"muscle","lvs":[3],"segs":[{"t":"外腹斜筋","r":"がいふくしゃきん","hard":1}],"x":76.7,"y":132.3,"map":"muscle","region":"おなか(前)","hint":"わき腹の筋肉。体をひねる・横に曲げる。"},{"id":"muscle-73","cat":"muscle","lvs":[3],"segs":[{"t":"前脛骨筋","r":"ぜんけいこつきん","hard":1}],"x":79.4,"y":264.6,"map":"muscle","region":"あし(前)","hint":"すねの外側の筋肉。つま先を上げる。"},{"id":"muscle-74","cat":"muscle","lvs":[3],"segs":[{"t":"僧帽筋","r":"そうぼうきん","hard":1}],"x":300,"y":82.5,"map":"muscle","region":"せなか(後ろ)","hint":"首から背中の上にひし形に広がる。肩甲骨を動かす。"},{"id":"muscle-75","cat":"muscle","lvs":[3],"segs":[{"t":"広背筋","r":"こうはいきん","hard":1}],"x":295,"y":130,"map":"muscle","region":"せなか(後ろ)","hint":"背中の下からわきへ広がる大きな筋肉。うでを後ろ下へ引く。"},{"id":"muscle-76","cat":"muscle","lvs":[3],"segs":[{"t":"ハムストリングス"}],"x":307.5,"y":210,"map":"muscle","region":"あし(後ろ)","hint":"ももの裏の3つの筋肉。ひざを曲げる、股関節をのばす。"}]}